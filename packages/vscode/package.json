{
  "name": "aretino-chant-tools",
  "displayName": "Aretino Chant Tools",
  "version": "0.1.1",
  "description": "Language support and live SVG preview for Aretino chant notation (.aretino files).",
  "publisher": "aretino-chant",
  "license": "MPL-2.0",
  "author": "Bertalan Fodor",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/aretino-chant/aretino-chant.git",
    "directory": "packages/vscode"
  },
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "gregorian",
    "chant",
    "music-notation",
    "aretino",
    "preview"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onLanguage:aretino"
  ],
  "contributes": {
    "languages": [
      {
        "id": "aretino",
        "aliases": [
          "Aretino Chant",
          "aretino"
        ],
        "extensions": [
          ".aretino"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "aretinoMeta",
        "description": "Aretino header key (%key:) and %% separator"
      },
      {
        "id": "aretinoComment",
        "description": "Aretino comment (% … and %[ … %] blocks)"
      },
      {
        "id": "aretinoFormat",
        "description": "Aretino inline-formatting delimiters { } < > [ ]"
      },
      {
        "id": "aretinoKeyword",
        "description": "Aretino line prefix (w:/W:/n:) and (directives)"
      },
      {
        "id": "aretinoText",
        "description": "Aretino lyric/verse/header text and \"labels\""
      },
      {
        "id": "aretinoPitch",
        "description": "Aretino pitch note plus modifiers"
      },
      {
        "id": "aretinoBarline",
        "description": "Aretino barlines , ; | || ||| :| |: :|: '"
      },
      {
        "id": "aretinoOperator",
        "description": "Aretino expander *, spacer =, neume separator /"
      },
      {
        "id": "aretinoNeume",
        "description": "Aretino neume grouping brackets [ ]"
      },
      {
        "id": "aretinoStrong",
        "description": "Aretino {bold} text"
      },
      {
        "id": "aretinoEmphasis",
        "description": "Aretino <italic> text"
      },
      {
        "id": "aretinoLink",
        "description": "Aretino [underline] text"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "aretino",
        "scopes": {
          "aretinoMeta": [
            "entity.name.tag.aretino"
          ],
          "aretinoComment": [
            "comment.line.aretino"
          ],
          "aretinoFormat": [
            "punctuation.definition.tag.aretino"
          ],
          "aretinoKeyword": [
            "keyword.control.aretino"
          ],
          "aretinoText": [
            "string.quoted.aretino"
          ],
          "aretinoPitch": [
            "constant.numeric.aretino"
          ],
          "aretinoBarline": [
            "keyword.control.aretino"
          ],
          "aretinoOperator": [
            "keyword.operator.aretino"
          ],
          "aretinoNeume": [
            "variable.other.constant.aretino",
            "constant.other.aretino"
          ],
          "aretinoStrong": [
            "markup.bold.aretino"
          ],
          "aretinoEmphasis": [
            "markup.italic.aretino"
          ],
          "aretinoLink": [
            "markup.underline.link.aretino",
            "markup.underline.aretino"
          ]
        }
      }
    ],
    "commands": [
      {
        "command": "aretino.showPreviewToSide",
        "title": "Open Preview to the Side",
        "category": "Aretino",
        "icon": "$(open-preview)"
      },
      {
        "command": "aretino.showPreview",
        "title": "Open Preview",
        "category": "Aretino",
        "icon": "$(open-preview)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "aretino.showPreviewToSide",
          "when": "resourceLangId == aretino",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "aretino.showPreviewToSide",
          "when": "resourceLangId == aretino"
        },
        {
          "command": "aretino.showPreview",
          "when": "resourceLangId == aretino"
        }
      ]
    },
    "keybindings": [
      {
        "command": "aretino.showPreviewToSide",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "resourceLangId == aretino"
      }
    ],
    "configuration": {
      "title": "Aretino Chant Tools",
      "properties": {
        "aretino.preview.autoOpen": {
          "type": "boolean",
          "default": true,
          "description": "Automatically open the preview to the side when an .aretino file is opened."
        },
        "aretino.preview.defaultZoom": {
          "type": "number",
          "default": 1.4,
          "minimum": 0.5,
          "maximum": 6,
          "description": "Initial on-screen magnification for the preview. The print staff space is small, so the preview is magnified for legibility without affecting layout."
        }
      }
    },
    "configurationDefaults": {
      "[aretino]": {
        "editor.semanticHighlighting.enabled": true,
        "editor.occurrencesHighlight": "off",
        "editor.selectionHighlight": false
      }
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "vscode:prepublish": "node esbuild.js --production",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies"
  },
  "devDependencies": {
    "@aretino-chant/core": "*",
    "@aretino-chant/editor": "*",
    "@types/vscode": "^1.84.0",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.21.0"
  }
}
